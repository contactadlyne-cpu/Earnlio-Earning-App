# SERVER CONFIGURATION
PORT=5000
NODE_ENV=production

# HOSTINGER SMTP EMAIL CONFIGURATION
# Set these with your Hostinger Email details from Hostinger hPanel / cPanel:
# Hostinger SMTP host: smtp.hostinger.com
# Port: 465 (SSL) or 587 (TLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_email_password_here
SMTP_FROM="Earnlio Rewards <noreply@yourdomain.com>"

# FRONTEND CORS ALLOWED ORIGIN
FRONTEND_URL=*
